@model SftpApi.Models.ViewModels.SftpIndexViewModel
@{
    ViewData["Title"] = "Upload to SFTP";
    Layout = "_Layout";
}

<h3 class="my-4">Upload File for <strong>@Model.AuthKey.Username</strong> (@Model.AuthKey.Host:@Model.AuthKey.Port)</h3>
<h4>Using: @Model.AuthKey.AuthType</h4>

<div id="alerts"></div>

<!-- Upload Form -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form id="fileForm" enctype="multipart/form-data" method="post">
            <div class="mb-3">
                <label for="fileInput" class="form-label">Choose file</label>
                <input type="file" id="fileInput" name="file" class="form-control" />
            </div>

            <div class="mb-3 d-flex gap-2">
                <button id="connectBtn" type="button" class="btn btn-primary">
                    <i class="bi bi-plug me-1"></i> Connect & Browse Server
                </button>
                <button id="uploadBtn" type="button" class="btn btn-success" disabled>
                    <i class="bi bi-upload me-1"></i> Upload To Selected Folder
                </button>
            </div>

            <input type="hidden" id="selectedPath" value="" />
        </form>
    </div>
</div>

<!-- FAILED JOBS DISPLAY -->
@if (Model.FailedJobs?.Any() == true)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-danger text-white">
            <i class="bi bi-exclamation-circle"></i> Failed Uploads
        </div>
        <div class="card-body">
            <ul class="list-group">
                @foreach (var fail in Model.FailedJobs)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Local:</strong> @fail.LocalFilePath<br />
                            <strong>Remote:</strong> @fail.RemotePath<br />
                            <small class="text-muted">Failed at: @fail.FailedAt</small>
                        </div>
                        <button class="btn btn-warning retryNowBtn" data-id="@fail.Id">
                            Retry Now
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-folder2-open me-1"></i> Remote Folder Tree
            </div>
            <div class="card-body" id="treeContainer" style="max-height:500px;overflow:auto;">
                <em>Connect to server to see folders</em>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
                <i class="bi bi-folder-check me-1"></i> Selected Folder
            </div>
            <div class="card-body" id="selectedContainer"><em>None</em></div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <i class="bi bi-file-earmark-text me-1"></i> Last Result
            </div>
            <div class="card-body p-2">
                <pre id="result" style="background:#f8f9fa;padding:8px;border-radius:4px;"></pre>
            </div>
        </div>
    </div>
</div>

<input type="text" id="localPath" name="localPath" hidden />

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        const recId = @Model.AuthKey.Id;
        let startPath = null;

        function showAlert(html, isError = false) {
            $('#alerts').html(`
                <div class="alert ${isError ? 'alert-danger' : 'alert-success'} alert-dismissible fade show" role="alert">
                    ${html}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `);
        }

        // Build folder tree
        function buildBranch(entries, parentUl) {
            entries.forEach(e => {
                const li = $('<div style="padding-left:8px;"></div>');
                const icon = $('<span style="cursor:pointer;">📁</span>');
                const label = $(`<span style="margin-left:6px;cursor:pointer">${e.name}</span>`);
                const expandBtn = $('<span style="margin-left:8px; cursor:pointer; color:blue;">[+]</span>');

                li.append(icon).append(label).append(expandBtn);

                const childrenContainer = $('<div style="display:none;margin-left:12px;"></div>');
                li.append(childrenContainer);

                label.on('click', function () {
                    $('#selectedPath').val(e.fullPath);
                    $('#selectedContainer').text(e.fullPath);
                    $('#uploadBtn').prop('disabled', false);
                });

                expandBtn.on('click', function () {
                    if (childrenContainer.is(':visible')) {
                        childrenContainer.slideUp();
                        expandBtn.text('[+]');
                        return;
                    }
                    if (childrenContainer.children().length === 0) {
                        fetchChildren(e.fullPath, childrenContainer, expandBtn);
                    } else {
                        childrenContainer.slideDown();
                        expandBtn.text('[-]');
                    }
                });

                parentUl.append(li);
            });
        }

        function fetchChildren(path, container, expandBtn) {
            $.get('@Url.Action("GetDirectories", "SftpMvcCustom")', { id: recId, path: path })
                .done(function (res) {
                    if (!res.success) { showAlert('Failed to list: ' + res.error, true); return; }
                    if (res.entries.length === 0) container.append('<div style="color:#666;padding-left:8px;">(empty)</div>');
                    else buildBranch(res.entries, container);
                    container.slideDown();
                    expandBtn.text('[-]');
                })
                .fail(function () { showAlert('Error listing directory', true); });
        }

        $('#connectBtn').on('click', function () {
            $('#connectBtn').prop('disabled', true).text('Connecting...');
            $.post('@Url.Action("TryConnect", "SftpMvcCustom")', { id: recId })
                .done(function (res) {
                    $('#connectBtn').prop('disabled', false).html('<i class="bi bi-plug me-1"></i> Connect & Browse Server');
                    if (!res.success) { showAlert('Connect failed: ' + res.error, true); return; }

                    startPath = res.startPath;
                    $('#treeContainer').empty();

                    $.get('@Url.Action("GetDirectories", "SftpMvcCustom")', { id: recId, path: startPath })
                        .done(function (res2) {
                            if (!res2.success) { showAlert('List failed: ' + res2.error, true); return; }
                            if (res2.entries.length === 0)
                                $('#treeContainer').html('<div>(no directories)</div>');
                            else
                                buildBranch(res2.entries, $('#treeContainer'));

                            showAlert('Connected. Browse folders and select destination.');
                            $('#selectedContainer').text(startPath);
                            $('#selectedPath').val(startPath);
                            $('#uploadBtn').prop('disabled', false);
                        });
                })
                .fail(function () {
                    $('#connectBtn').prop('disabled', false).html('<i class="bi bi-plug me-1"></i> Connect & Browse Server');
                    showAlert('Connect failed (network)', true);
                });
        });

        $('#uploadBtn').on('click', function () {
            const path = $('#selectedPath').val();
            const file = $('#fileInput')[0].files[0];

            if (!path) return showAlert('Please select a folder first', true);
            if (!file) return showAlert('Please choose a file first', true);

            $('#uploadBtn').prop('disabled', true).html('<i class="bi bi-upload me-1"></i> Uploading...');

            const form = new FormData();
            form.append('remotePath', path);
            form.append('id', recId);
            form.append('file', file);

            $.ajax({
                url: '@Url.Action("SaveToServer", "SftpMvcCustom")',
                type: 'POST',
                data: form,
                processData: false,
                contentType: false
            }).done(function (res) {

                $('#uploadBtn').prop('disabled', false)
                    .html('<i class="bi bi-upload me-1"></i> Upload To Selected Folder');

                if (!res.success) {

                    $('#result').html(`
                        <div>Upload failed: ${res.message}</div>
                        <button class="btn btn-warning mt-2 retryNowBtn" data-id="${res.failedId}">
                            Retry Now
                        </button>
                    `);

                    showAlert(res.message, true);
                    return;
                }

                $('#result').text('Uploaded: ' + res.remoteFile);
                showAlert('Upload succeeded');
            })
            .fail(function () {
                $('#uploadBtn').prop('disabled', false)
                    .html('<i class="bi bi-upload me-1"></i> Upload To Selected Folder');
                showAlert('Upload failed (network)', true);
            });
        });

        // Retry buttons (both from failed jobs list and upload errors)
        $(document).on('click', '.retryNowBtn', function () {
            const failedId = $(this).data('id');

            $.post('@Url.Action("RetryNow", "SftpMvcCustom")', { failedId })
                .done(function (res) {
                    if (!res.success) return alert("Retry failed: " + res.error);
                    alert("Retry job queued successfully!");
                })
                .fail(function () {
                    alert("Error calling retry.");
                });
        });
    </script>
}
